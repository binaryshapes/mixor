{
  "name": "@nuxo/tools",
  "version": "1.0.0",
  "description": "Nuxo package with common configurations for development tools",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "type": "module",
  "keywords": [
    "eslint",
    "typescript",
    "tsconfig",
    "prettier",
    "commitlint",
    "tsup"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/binaryshapes/nuxo",
    "directory": "packages/tools"
  },
  "files": [
    "*.json",
    "dist"
  ],
  "bin": {
    "sync-release-please": "./dist/bin/sync-release-please.mjs"
  },
  "exports": {
    "./commitlint": {
      "development": "./src/commitlint/index.ts",
      "types": "./dist/src/commitlint/index.d.ts",
      "import": "./dist/src/commitlint/index.mjs",
      "default": "./dist/src/commitlint/index.cjs"
    },
    "./eslint": {
      "development": "./src/eslint/index.ts",
      "types": "./dist/src/eslint/index.d.ts",
      "import": "./dist/src/eslint/index.mjs",
      "default": "./dist/src/eslint/index.cjs"
    },
    "./prettier": {
      "development": "./src/prettier/index.ts",
      "types": "./dist/src/prettier/index.d.ts",
      "import": "./dist/src/prettier/index.mjs",
      "default": "./dist/src/prettier/index.cjs"
    },
    "./tsup": {
      "development": "./src/tsup/index.ts",
      "types": "./dist/src/tsup/index.d.ts",
      "import": "./dist/src/tsup/index.mjs",
      "default": "./dist/src/tsup/index.cjs"
    },
    "./typescript/*.tsconfig.json": {
      "development": "./src/typescript/*.tsconfig.json",
      "import": "./dist/src/typescript/*.tsconfig.json",
      "default": "./dist/src/typescript/*.tsconfig.json"
    },
    "./vitest": {
      "development": "./src/vitest/index.ts",
      "types": "./dist/src/vitest/index.d.ts",
      "import": "./dist/src/vitest/index.mjs",
      "default": "./dist/src/vitest/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "publish-local": "pnpm publish --registry=http://localhost:4873 --no-git-checks",
    "unpublish-local": "npm unpublish --registry=http://localhost:4873/ --force",
    "republish-local": "pnpm unpublish-local && pnpm publish-local"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@commitlint/prompt-cli": "20.2.0",
    "@commitlint/types": "20.2.0",
    "@nx/eslint-plugin": "22.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.0",
    "@types/node": "25.0.3",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/ui": "4.0.16",
    "deepmerge-ts": "7.1.5",
    "eslint": "9.39.2",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-tsdoc": "0.5.0",
    "husky": "9.1.7",
    "jsonc-eslint-parser": "2.4.2",
    "prettier": "3.7.4",
    "prettier-plugin-multiline-arrays": "4.1.3",
    "tslib": "2.8.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.0.16"
  },
  "peerDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@commitlint/prompt-cli": "20.2.0",
    "@commitlint/types": "20.2.0",
    "@nx/eslint-plugin": "22.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.0",
    "@types/node": "25.0.3",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/ui": "4.0.16",
    "deepmerge-ts": "7.1.5",
    "eslint": "9.39.2",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-tsdoc": "0.5.0",
    "husky": "9.1.7",
    "jsonc-eslint-parser": "2.4.2",
    "prettier": "3.7.4",
    "prettier-plugin-multiline-arrays": "4.1.3",
    "tslib": "2.8.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.0.16"
  }
}
